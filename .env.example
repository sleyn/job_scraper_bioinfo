# Copy this file to .env and fill in values before running `docker compose up`.

# Required by Airflow's docker-compose to avoid file-permission issues on
# mounted volumes (dags/, config/, data/). On macOS/Linux, set this to your
# user id, e.g.: AIRFLOW_UID=$(id -u)
AIRFLOW_UID=50000

# Airflow's Fernet key for encrypting connections/variables in its metadata DB.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Airflow's webserver secret key. Shared by the webserver and scheduler containers so
# the webserver can authenticate when fetching task logs from the scheduler's log
# server; left unset, each container picks its own random default and log fetches
# 403. Generate one with: python -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_SECRET_KEY=

# Career-history reference data, read by job_scraper/scoring/*. These files live in the
# sibling AI_Job_Helper project; each gets its own env var (machine-specific absolute
# paths) so this repo never depends on that project's directory layout.

# Your career-history notes, split into sections by the scorer. Required for scoring.
JOB_HELPER_MEMORY_PATH=

# The generic resume the scorer compares job descriptions against. Required for scoring.
JOB_HELPER_RESUME_PATH=

# Under Docker, docker-compose.yaml bind-mounts the two files above (read-only) onto
# fixed container paths and overrides the vars to point there, so these host paths are
# only read by Compose itself. Both must be set or `docker compose up` refuses to start.

# CSV of hand-scored job descriptions. Only needed by
# `python -m job_scraper.scoring.train_export`, which runs on the host — it is
# deliberately not passed into the Airflow container.
JOB_HELPER_JD_SCORES_CSV=

# Directory holding one <name>/jd.md per row of the CSV above, where <name> is that
# row's Name column. Its own var rather than being derived from the CSV's location:
# the two need not sit in the same place, and this repo assumes nothing about how
# AI_Job_Helper arranges them (ADR-0001). Training-only, like the CSV.
JOB_HELPER_JD_DIR=

# Set to 1 to pin the scoring embedding model to the locally cached weights instead of
# revalidating against the HuggingFace Hub on every load. Avoids the anonymous rate limit
# and a few seconds of round-trips, and stops a new upstream revision from silently
# changing the features the exported regressor was fitted on. Leave unset on a machine
# that has never downloaded the model, so the first run can fetch it.
HF_HUB_OFFLINE=1

# Optional. Where the HuggingFace cache lives on the host; docker-compose.yaml mounts this
# into the Airflow containers so the ~500MB embedding model is not re-fetched on every cold
# start. Defaults to ~/.cache/huggingface, which is where a local run puts it already.
HF_HOME=
